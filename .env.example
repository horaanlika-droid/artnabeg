# ===== Telegram =====
BOT_TOKEN=123456789:AA...           # токен бота от @BotFather
ADMIN_ID=123456789                  # твой Telegram ID (узнать: @userinfobot)
PUBLIC_URL=                         # https-домен, напр. https://артнабег.ru или от BotHost — для кнопки мини-аппа

# ===== TON / грам (привязка кошелька через API) =====
TON_API_BASE=https://tonapi.io      # API провайдер (tonapi.io)
TON_API_KEY=                        # ключ tonapi.io (бесплатный — t.me/tonapibot)
TREASURY_ADDRESS=                   # адрес площадки для приёма оплат (EQ...)

# ===== Приём платежей в TON =====
CRYPTO_BOT_TOKEN=                   # токен @CryptoBot (Crypto Pay API). Пусто = демо-оплата

# ===== Приложение =====
PORT=3000
SESSION_SECRET=сменить-на-случайную-строку
ALLOW_DEMO=1                        # 0 в проде — выключит демо-вход и демо-оплату
